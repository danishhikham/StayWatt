# Database lokal (XAMPP). Railway dapat memakai MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE tanpa menambah DB_*.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=staywatt
# Port untuk server bawaan PHP (php scripts/serve.php)
PORT=3000
# Zona waktu aplikasi
TIMEZONE=Asia/Jakarta
# Opsional: paksa lokasi aplikasi bila terdeteksi salah (mis. /staywatt). Kosongkan untuk otomatis.
# BASE_URL=/staywatt
